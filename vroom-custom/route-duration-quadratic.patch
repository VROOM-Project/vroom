+#include <cmath>
+
 #include "algorithms/local_search/operator.h"
 
 namespace vroom::ls {
 
+namespace {
+
+Cost route_duration_quadratic_penalty(const Vehicle& vehicle,
+                                      const Eval& eval) {
+  if (vehicle.costs.route_duration_quadratic == 0) {
+    return 0;
+  }
+
+  const auto route_duration = eval.duration + eval.task_duration;
+  const long double duration_hours =
+    static_cast<long double>(route_duration) /
+    (static_cast<long double>(DURATION_FACTOR) * 3600.L);
+
+  return static_cast<Cost>(std::llround(
+    static_cast<long double>(vehicle.costs.route_duration_quadratic) *
+    duration_hours * duration_hours));
+}
+
+} // namespace
+
 OperatorName Operator::get_name() const {
   return _name;
 }
 
 Eval Operator::gain() {
   if (!gain_computed) {
     this->compute_gain();
+
+    if (s_vehicle == t_vehicle) {
+      const auto& vehicle = _input.vehicles[s_vehicle];
+      if (vehicle.costs.route_duration_quadratic > 0) {
+        const auto old_eval = _sol_state.route_evals[s_vehicle];
+        const auto new_eval = old_eval - stored_gain;
+        stored_gain.cost += route_duration_quadratic_penalty(vehicle, old_eval) -
+                            route_duration_quadratic_penalty(vehicle, new_eval);
+      }
+    } else {
+      const auto& s_v = _input.vehicles[s_vehicle];
+      const auto& t_v = _input.vehicles[t_vehicle];
+      const auto old_s_eval = _sol_state.route_evals[s_vehicle];
+      const auto old_t_eval = _sol_state.route_evals[t_vehicle];
+      const auto new_s_eval = old_s_eval - s_gain;
+      const auto new_t_eval = old_t_eval - t_gain;
+
+      stored_gain.cost += route_duration_quadratic_penalty(s_v, old_s_eval) -
+                          route_duration_quadratic_penalty(s_v, new_s_eval) +
+                          route_duration_quadratic_penalty(t_v, old_t_eval) -
+                          route_duration_quadratic_penalty(t_v, new_t_eval);
+    }
   }
   return stored_gain;
 }
